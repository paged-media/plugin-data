# Rust
/target

# clean-room mounts — never committed (NOT mounted in M0; see CLAUDE.md)
references/

# TS
node_modules/
dist/
*.tsbuildinfo

# wasm-bindgen build outputs (regenerated by scripts/build-wasm.sh;
# bin/.gitkeep keeps the directory)
packages/data-bundle/bin/*.wasm
packages/data-bundle/bin/*.js
packages/data-bundle/bin/*.d.ts
packages/data-bundle/bin/SOURCE_HASH
packages/data-bundle/bin/PACKAGE_HASH
# the staged DuckDB engine set (scripts/vendor-duckdb.sh): duckdb-engine.wasm,
# duckdb-browser-eh.worker.js, duckdb-browser.mjs — shipped in the tarball,
# never committed
packages/data-bundle/bin/*.mjs
# DuckDB's json + parquet extensions for the shipped engine
# (scripts/vendor-duckdb.sh; bin/duckdb-ext/<engine>/wasm_eh/*.duckdb_extension.wasm)
packages/data-bundle/bin/duckdb-ext/

# vendored DuckDB-WASM dist — acquired by scripts/vendor-duckdb.sh, NOT
# committed (multi-MB MIT artifact; SOURCE.md records provenance). The
# .gitkeep + SOURCE.md keep the directory + the attribution record.
vendor/duckdb-wasm/*.wasm
vendor/duckdb-wasm/*.js
vendor/duckdb-wasm/*.mjs
vendor/duckdb-wasm/*.worker.js
vendor/duckdb-wasm/dist/
vendor/duckdb-wasm/extensions/

# oracle venv (native-DuckDB differential harness, if ever local)
.venv/
.wf/
