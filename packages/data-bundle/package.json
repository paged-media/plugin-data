{
  "name": "@paged-media/data",
  "private": false,
  "version": "0.1.0-canary.9",
  "license": "AGPL-3.0-only OR LicenseRef-PMEL",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./manifest.json": "./manifest.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run test/pipeline-real.spec.ts test/duckdb-real.spec.ts",
    "test:duckdb": "REQUIRE_REAL_DUCKDB=1 vitest run test/duckdb-real.spec.ts",
    "pubcheck": "pnpm run build && node ../../scripts/pubcheck.mjs",
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@paged-media/plugin-api": ">=0.2.29-canary.0",
    "@paged-media/plugin-sdk": ">=0.2.29-canary.0",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@paged-media/data-host-model": "workspace:*",
    "@paged-media/plugin-api": "0.2.39-canary.0",
    "@paged-media/plugin-sdk": "0.2.39-canary.0",
    "@types/node": "20.19.39",
    "@types/react": "^18.3.31",
    "apache-arrow": "^17.0.0",
    "react": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "files": [
    "dist",
    "bin/data_js.js",
    "bin/data_js.d.ts",
    "bin/data_js_bg.wasm",
    "bin/data_js_bg.wasm.d.ts",
    "bin/duckdb-engine.wasm",
    "bin/duckdb-browser-eh.worker.js",
    "bin/duckdb-browser.mjs",
    "bin/SOURCE_HASH",
    "bin/PACKAGE_HASH",
    "manifest.json"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "canary",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./manifest.json": "./manifest.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paged-media/plugin-data.git",
    "directory": "packages/data-bundle"
  }
}
