{
  "id": "media.paged.data",
  "name": "paged.data",
  "version": "0.1.0-canary.10",
  "apiVersion": "^0.2",
  "publisher": "paged.media",
  "capabilities": {
    "document": {
      "read": "broad",
      "write": "scoped"
    },
    "rendering": [
      "hitTest"
    ],
    "network": {
      "origins": "consent",
      "purpose": "Fetch author-selected remote data sources (CSV/JSON/Parquet over HTTP(S)) at edit time, per-origin consented — never on document open."
    },
    "clipboard": "none",
    "wasm": [
      {
        "name": "data-engine",
        "path": "bin/data_js_bg.wasm",
        "purpose": "compute",
        "maxBytes": 8388608
      },
      {
        "name": "duckdb-engine",
        "path": "bin/duckdb-engine.wasm",
        "purpose": "engine",
        "maxBytes": 50331648
      },
      {
        "name": "duckdb-ext-json",
        "path": "bin/duckdb-ext/v1.1.1/wasm_eh/json.duckdb_extension.wasm",
        "purpose": "engine",
        "maxBytes": 1048576
      },
      {
        "name": "duckdb-ext-parquet",
        "path": "bin/duckdb-ext/v1.1.1/wasm_eh/parquet.duckdb_extension.wasm",
        "purpose": "engine",
        "maxBytes": 4194304
      }
    ],
    "dataProviders": {
      "publish": [
        "dataset"
      ]
    }
  },
  "contributes": {
    "panels": [
      "media.paged.data.panel.sources",
      "media.paged.data.panel.bindings",
      "media.paged.data.panel.dataset",
      "media.paged.data.panel.query"
    ],
    "commands": [
      "media.paged.data.command.importData",
      "media.paged.data.command.defineBinding",
      "media.paged.data.command.resolveBindings",
      "media.paged.data.command.lowerBinding",
      "media.paged.data.command.mergeRecords",
      "media.paged.data.command.openDataset",
      "media.paged.data.command.captureDataSet",
      "media.paged.data.command.applyDataSet",
      "media.paged.data.command.editQuery"
    ],
    "importers": [
      "media.paged.data.importer.table"
    ],
    "editContexts": [
      {
        "type": "dataBinding",
        "entry": "doubleClick"
      }
    ],
    "partTypes": [
      {
        "type": "session",
        "role": "spec",
        "format": "json",
        "linkable": false
      },
      {
        "type": "data",
        "role": "source",
        "format": "csv",
        "linkable": false
      },
      {
        "type": "data-json",
        "role": "source",
        "format": "json",
        "linkable": false
      },
      {
        "type": "data-parquet",
        "role": "source",
        "format": "parquet",
        "linkable": false
      },
      {
        "type": "data-xlsx",
        "role": "source",
        "format": "xlsx",
        "linkable": false
      }
    ]
  }
}
